# check-ocp-private-endpoint.sentinel
# CKV_IBM_1 — OCP cluster public service endpoint must be disabled
# Enforcement: hard-mandatory
# Resource:    ibm_container_vpc_cluster
# Attribute:   disable_public_service_endpoint must be true

import "tfplan/v2" as tfplan

# Find all OCP VPC cluster resources being created or updated
ocp_clusters = filter tfplan.resource_changes as _, rc {
    rc.mode is "managed" and
    rc.type is "ibm_container_vpc_cluster" and
    (rc.change.actions contains "create" or
     rc.change.actions contains "update")
}

# Every cluster must have the public service endpoint disabled
deny_public_endpoint = rule {
    all ocp_clusters as _, rc {
        rc.change.after.disable_public_service_endpoint else false is true
    }
}

main = rule { deny_public_endpoint }
